<div class="var-borg-test-dialog">
  <h4>{{localize "VARBORG.Contest.You"}}</h4>
  <div class="form-group">
    <label for="var-borg-contest-ability">{{localize "VARBORG.Contest.Ability"}}</label>
    <select id="var-borg-contest-ability" name="ability">
      {{#each abilities}}
      <option value="{{key}}">{{localize label}}</option>
      {{/each}}
    </select>
  </div>
  {{> "systems/var-borg/templates/dice/boon-bane.hbs" noHint=true}}

  <h4>{{localize "VARBORG.Contest.Opponent"}}</h4>
  <div class="form-group">
    <label for="var-borg-contest-opponent">{{localize "VARBORG.Contest.Opponent"}}</label>
    <select id="var-borg-contest-opponent" name="opponent">
      <option value="{{foe}}" selected>{{localize "VARBORG.Contest.FoeOption"}}</option>
      {{#each characters}}
      <option value="{{id}}">{{name}}</option>
      {{/each}}
    </select>
  </div>
  <div class="form-group">
    <label for="var-borg-contest-foe-name">{{localize "VARBORG.Contest.FoeName"}}</label>
    <input id="var-borg-contest-foe-name" type="text" name="foeName"
           placeholder="{{localize 'VARBORG.Contest.FoeDefaultName'}}">
    <p class="hint">{{localize "VARBORG.Contest.FoeHint"}}</p>
  </div>
  <div class="form-group">
    <label for="var-borg-contest-opponent-ability">{{localize "VARBORG.Contest.OpponentAbility"}}</label>
    <select id="var-borg-contest-opponent-ability" name="opponentAbility">
      {{#each abilities}}
      <option value="{{key}}">{{localize label}}</option>
      {{/each}}
    </select>
  </div>
  {{> "systems/var-borg/templates/dice/boon-bane.hbs" boonName="opponentBoon" baneName="opponentBane" noHint=true}}
  <p class="hint">{{localize "VARBORG.Contest.CharacterHint"}}</p>
</div>

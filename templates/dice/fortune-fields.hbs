<div class="form-group vb-choice-row">
  <label>
    {{localize "VARBORG.Fortune.DialogLabel"}}
    <span class="vb-have">{{have}}</span>
  </label>
  <div class="vb-toggles">
    <label class="vb-toggle">
      <input type="checkbox" name="fortuneBoon" {{#unless fortune}}disabled{{/unless}}>
      <span>{{localize "VARBORG.Test.Boon"}}</span>
    </label>
    <label class="vb-toggle">
      <input type="checkbox" name="fortuneBane" {{#unless fortune}}disabled{{/unless}}>
      <span>{{localize "VARBORG.Test.Bane"}}</span>
    </label>
  </div>
  <p class="hint">{{localize "VARBORG.Fortune.DialogHint"}}</p>
</div>

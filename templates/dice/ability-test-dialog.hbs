<div class="var-borg-test-dialog">
  {{#if purpose}}<p class="purpose">{{purpose}}</p>{{/if}}
  <div class="form-group">
    <label for="var-borg-test-dr">{{localize "VARBORG.Test.DR"}}</label>
    <select id="var-borg-test-dr" name="dr">
      {{#each drs}}
      <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
    {{#if armourNote}}<p class="hint automatic">{{armourNote}}</p>{{/if}}
  </div>
  {{#if encumberedNote}}<p class="hint automatic">{{encumberedNote}}</p>{{/if}}
  {{#each conditionNotes}}<p class="hint automatic">{{this}}</p>{{/each}}
  {{#each reminders}}<p class="hint reminder">{{this}}</p>{{/each}}
  {{> "systems/var-borg/templates/dice/boon-bane.hbs" boon=boon bane=bane}}
  {{{fortuneFields}}}
  <div class="form-group vb-choice-row">
    <label>{{localize "VARBORG.Test.AidLabel"}}</label>
    <div class="vb-steppers">
      <div class="vb-stepper">
        <label for="var-borg-test-aid-successes">{{localize "VARBORG.Test.AidSuccesses"}}</label>
        <button type="button" data-vb-step="-1" aria-label="{{localize 'VARBORG.Dialog.Less'}}">−</button>
        <input id="var-borg-test-aid-successes" type="number" name="aidSuccesses" value="0" min="0" step="1">
        <button type="button" data-vb-step="1" aria-label="{{localize 'VARBORG.Dialog.More'}}">+</button>
      </div>
      <div class="vb-stepper">
        <label for="var-borg-test-aid-failures">{{localize "VARBORG.Test.AidFailures"}}</label>
        <button type="button" data-vb-step="-1" aria-label="{{localize 'VARBORG.Dialog.Less'}}">−</button>
        <input id="var-borg-test-aid-failures" type="number" name="aidFailures" value="0" min="0" step="1">
        <button type="button" data-vb-step="1" aria-label="{{localize 'VARBORG.Dialog.More'}}">+</button>
      </div>
    </div>
    <p class="hint">{{localize "VARBORG.Test.AidHint"}}</p>
  </div>
  {{{optionalEffects}}}
</div>

<div class="var-borg-test-dialog defence-dialog">
  <p class="hint automatic">{{against}}{{#if damage}} · {{damage}}{{/if}}</p>
  {{#each notes}}<p class="hint automatic">{{this}}</p>{{/each}}
  <div class="form-group">
    <label for="var-borg-defence-dr">{{localize "VARBORG.Test.DR"}}</label>
    <select id="var-borg-defence-dr" name="dr">
      {{#each drs}}
      <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
    <p class="hint">{{localize "VARBORG.Defence.AutomaticHint"}}</p>
  </div>
  <div class="form-group">
    <label for="var-borg-defence-boon">{{localize "VARBORG.Test.Boon"}}</label>
    <input id="var-borg-defence-boon" type="checkbox" name="boon">
    <p class="hint">{{localize "VARBORG.Test.BoonHint"}}</p>
  </div>
  <div class="form-group">
    <label for="var-borg-defence-bane">{{localize "VARBORG.Test.Bane"}}</label>
    <input id="var-borg-defence-bane" type="checkbox" name="bane">
    <p class="hint">{{localize "VARBORG.Test.BaneHint"}}</p>
  </div>
</div>

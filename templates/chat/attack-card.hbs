<div class="var-borg-card test-card attack-card">
  <h3>{{title}}</h3>
  <p class="modifier">{{how}}{{#if target}} · {{target}}{{/if}}
    {{#if retarget}}
    <button type="button" class="retarget" data-action="retargetAttack"
            data-tooltip="{{localize 'VARBORG.Attack.RetargetTooltip'}}" aria-label="{{localize 'VARBORG.Attack.RetargetTooltip'}}">
      <i class="fa-solid fa-crosshairs" aria-hidden="true"></i>
    </button>
    {{/if}}
  </p>
  {{#if retargetNote}}<p class="modifier">{{retargetNote}}</p>{{/if}}
  <div class="dice">
    {{#each dice}}
    <span class="die {{#unless kept}}dropped{{/unless}}">{{value}}</span>
    {{/each}}
    {{#if modeLabel}}<span class="mode">{{modeLabel}}</span>{{/if}}
  </div>
  <p class="sum">
    {{localize "VARBORG.Test.KeptDie"}} {{kept}}
    · {{abilityLabel}} {{ability}}
  </p>
  <p class="total">
    <strong>{{total}}</strong> {{localize "VARBORG.Test.Versus"}} <strong>{{localize "VARBORG.Test.DR"}} {{dr}}</strong>
    {{#if drNote}}<span class="modifier">{{drNote}}</span>{{/if}}
  </p>
  {{#each notes}}<p class="modifier">{{this}}</p>{{/each}}
  <p class="tier tier-{{tier}}">{{tierLabel}}</p>
  {{#if naturalNote}}<p class="natural">{{naturalNote}}</p>{{/if}}
  {{#if tierOutcomes}}
  <ul class="tier-outcomes">
    {{#each tierOutcomes}}
    <li class="tier-outcome{{#if rolled}} rolled tier-{{tier}}{{/if}}"><strong>{{label}}:</strong> {{text}}</li>
    {{/each}}
  </ul>
  {{else}}
  <p class="outcome">{{outcomeText}}</p>
  {{/if}}
  {{#if description}}<p class="power-description">{{description}}</p>{{/if}}
  {{#if sustainNote}}<p class="modifier">{{sustainNote}}</p>{{/if}}
  {{#each outcomeLines}}<p class="modifier outcome-line">{{this}}</p>{{/each}}
  {{#if shadowblight}}
  <button type="button" data-action="rollShadowblight" data-actor-uuid="{{shadowblight.actorUuid}}">
    <i class="fa-solid fa-skull"></i> {{localize "VARBORG.Shadowblight.Button"}}
  </button>
  {{/if}}
  {{#if ruinNote}}<p class="modifier">{{ruinNote}}</p>{{/if}}
  {{#if damage}}
  <div class="damage">
    {{#if damage.invalid}}
    <p class="modifier">{{localize "VARBORG.Attack.BadDamage" formula=damage.formula}}</p>
    {{else}}
    <p class="damage-line">
      {{localize "VARBORG.Attack.Damage"}} ({{damage.formula}}):
      {{#if damage.doubled}}{{damage.rolled}} × 2 = {{/if}}{{#if damage.halved}}{{damage.rolled}} ÷ 2 = {{/if}}{{#if damage.extra}}{{damage.extra.before}} + {{damage.extra.value}} ({{damage.extra.formula}}, {{localize "VARBORG.Attack.OnTriumph"}}) = {{/if}}<strong class="damage-total">{{damage.total}}</strong>
      {{#if damage.maximized}}<span class="modifier">{{localize "VARBORG.Fortune.Maximum"}}</span>{{/if}}
    </p>
    {{/if}}
    {{#if area}}
    <p class="hint">{{localize "VARBORG.Area.Hint"}}</p>
    {{#each area.foes}}
    <button type="button" data-action="inflictDamage" data-key="{{key}}" data-damage="{{damage}}" data-foe-uuid="{{foeUuid}}"
            data-armour="{{armour}}" data-attack="{{attack}}" data-damage-type="{{damageType}}" data-weapon-tags="{{weaponTags}}">
      <i class="fa-solid fa-droplet"></i> {{label}}
    </button>
    {{/each}}
    {{#each area.defenders}}
    <button type="button" data-action="areaDefend" data-actor-uuid="{{uuid}}" data-damage="{{damage}}" data-name="{{name}}"
            data-caster-uuid="{{casterUuid}}" data-damage-type="{{damageType}}">
      <i class="fa-solid fa-shield-halved"></i> {{label}}
    </button>
    {{/each}}
    {{/if}}
    {{#if inflict}}
    <button type="button" data-action="inflictDamage" data-damage="{{inflict.damage}}" data-foe-uuid="{{inflict.foeUuid}}"
            data-armour="{{inflict.armour}}" data-attack="{{inflict.attack}}" data-damage-type="{{inflict.damageType}}" data-melee="{{inflict.melee}}" data-weapon-tags="{{inflict.weaponTags}}" data-triumph="{{inflict.triumph}}">
      <i class="fa-solid fa-droplet"></i> {{inflict.label}}
    </button>
    {{/if}}
  </div>
  {{/if}}
  {{#if armour}}
  {{#if armour.button}}
  <button type="button" data-action="lowerArmour" data-uuid="{{armour.uuid}}">
    <i class="fa-solid fa-shield-halved"></i> {{armour.button}}
  </button>
  {{else}}
  <p class="modifier">{{armour.text}}</p>
  {{/if}}
  {{/if}}
  {{#if thrownNote}}<p class="modifier">{{thrownNote}}</p>{{/if}}
  {{#if pipNote}}<p class="modifier">{{pipNote}}</p>{{/if}}
  {{{fortune}}}
</div>

<div class="var-borg-card treasure-card">
  <h3>{{heading}}</h3>
  {{#if settings}}<p class="modifier">{{settings}}</p>{{/if}}
  <p><strong>{{coin}}</strong></p>
  <p class="modifier">{{spoils}}</p>
  <ul class="treasure-finds">
    {{#each lines}}
      <li>{{this}}</li>
    {{/each}}
  </ul>
  {{#if chestLine}}<p>{{chestLine}}</p>{{/if}}
  {{#if canPlace}}
  <div class="card-buttons">
    <button type="button" data-action="placeTreasure">
      <i class="fa-solid fa-box-open"></i> {{localize "VARBORG.Treasure.Place"}}
    </button>
  </div>
  {{/if}}
</div>

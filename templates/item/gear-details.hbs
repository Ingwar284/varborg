<section class="var-borg-item-details">
  <div class="field-grid">
    <label data-tooltip="{{localize 'VARBORG.Item.QuantityHint'}}">
      <span>{{localize "VARBORG.Item.Quantity"}}</span>
      <input type="number" name="system.quantity" value="{{system.quantity}}" min="0" step="1">
    </label>
    <label data-tooltip="{{localize 'VARBORG.Trait.expendableHint'}}">
      <span>{{localize "VARBORG.Item.Expendable"}}</span>
      <select name="system.expendable">{{selectOptions expendableDice selected=system.expendable localize=true}}</select>
    </label>
    {{#if system.expendable}}
    <label data-tooltip="{{localize 'VARBORG.Expendable.UsedUpHint'}}">
      <span>{{localize "VARBORG.Expendable.UsedUp"}}</span>
      <input type="checkbox" name="system.usedUp" {{checked system.usedUp}}>
    </label>
    {{/if}}
    <label data-tooltip="{{localize 'VARBORG.Item.MedicineHint'}}">
      <span>{{localize "VARBORG.Item.Medicine"}}</span>
      <input type="checkbox" name="system.medicine" {{checked system.medicine}}>
    </label>
    <label data-tooltip="{{localize 'VARBORG.Light.KindHint'}}">
      <span>{{localize "VARBORG.Light.KindLabel"}}</span>
      <select name="system.light">{{selectOptions lightKinds selected=system.light localize=true}}</select>
    </label>
    {{#if showLightMinutes}}
    <label data-tooltip="{{localize 'VARBORG.Light.BurnsForHint'}}">
      <span>{{localize "VARBORG.Light.BurnsFor"}}</span>
      <input type="number" name="system.lightMinutes" value="{{system.lightMinutes}}" min="1" step="1">
    </label>
    {{/if}}
    {{#if showLightRange}}
    <label data-tooltip="{{localize 'VARBORG.Light.RangeHint'}}">
      <span>{{localize "VARBORG.Light.Range"}}</span>
      <input type="number" name="system.lightRange" value="{{system.lightRange}}" min="1" step="1">
    </label>
    {{/if}}
    <label data-tooltip="{{localize 'VARBORG.Uses.FrequencyHint'}}">
      <span>{{localize "VARBORG.Uses.FrequencyLabel"}}</span>
      <select name="system.frequency">{{selectOptions frequencies selected=system.frequency localize=true}}</select>
    </label>
    {{#if system.frequency}}
    <label data-tooltip="{{localize 'VARBORG.Uses.UsedHint'}}">
      <span>{{localize "VARBORG.Uses.Used"}}</span>
      <input type="checkbox" name="system.frequencyUsed" {{checked system.frequencyUsed}}>
    </label>
    {{/if}}
  </div>
</section>

<section class="var-borg-item-details">
  <div class="field-grid">
    <label data-tooltip="{{localize 'VARBORG.Item.QuantityHint'}}">
      <span>{{localize "VARBORG.Item.Quantity"}}</span>
      <input type="number" name="system.quantity" value="{{system.quantity}}" min="1" step="1">
    </label>
    <label data-tooltip="{{localize 'VARBORG.Trait.expendableHint'}}">
      <span>{{localize "VARBORG.Item.Expendable"}}</span>
      <select name="system.expendable">{{selectOptions expendableDice selected=system.expendable localize=true}}</select>
    </label>
    {{#if system.expendable}}
    <label data-tooltip="{{localize 'VARBORG.Expendable.UsedUpHint'}}">
      <span>{{localize "VARBORG.Expendable.UsedUp"}}</span>
      <input type="checkbox" name="system.usedUp" {{checked system.usedUp}}>
    </label>
    {{/if}}
    <label data-tooltip="{{localize 'VARBORG.Item.MedicineHint'}}">
      <span>{{localize "VARBORG.Item.Medicine"}}</span>
      <input type="checkbox" name="system.medicine" {{checked system.medicine}}>
    </label>
  </div>
</section>

<header class="var-borg-item-header">
  <img class="item-img" src="{{item.img}}" alt="{{item.name}}" data-action="editImage" data-edit="img">
  <div class="item-title">
    <input class="item-name" type="text" name="name" value="{{item.name}}" placeholder="{{localize 'VARBORG.Sheet.Name'}}">
    <div class="item-meta">
      <label>
        <span>{{localize "VARBORG.Feat.SourceLabel"}}</span>
        <select name="system.source">{{selectOptions sources selected=system.source localize=true}}</select>
      </label>
      {{#if canImprove}}
      <label data-tooltip="{{localize 'VARBORG.Feat.ImprovingHint'}}">
        <input type="checkbox" name="system.improving" {{checked system.improving}}>
        <span>{{localize "VARBORG.Feat.Improving"}}</span>
      </label>
      {{/if}}
    </div>
  </div>
</header>

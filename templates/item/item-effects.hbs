<section class="var-borg-item-effects">
  {{#with effectsPart}}
  <header class="effects-header">
    <h3>{{localize "VARBORG.Effects.Title"}}</h3>
    <label data-tooltip="{{localize 'VARBORG.Effects.AutomationHint'}}">
      <span>{{localize "VARBORG.Effects.AutomationLabel"}}</span>
      <select name="system.automation" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions automations selected=automation localize=true}}</select>
    </label>
    {{#if @root.editable}}
    <button type="button" data-action="addEffect" data-tooltip="{{localize 'VARBORG.Effects.Add'}}"><i class="fa-solid fa-plus"></i></button>
    {{/if}}
  </header>
  {{#unless list.length}}
  <p class="hint">{{localize "VARBORG.Effects.None"}}</p>
  {{/unless}}
  {{#each list}}
  <div class="effect-row" data-effect-index="{{index}}">
    <select data-effect-field="kind" aria-label="{{localize 'VARBORG.Effects.KindLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions kinds selected=kind localize=true}}</select>
    {{#if isStat}}
    <select data-effect-field="target" aria-label="{{localize 'VARBORG.Effects.TargetLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../targets selected=target localize=true}}</select>
    <select data-effect-field="op" aria-label="{{localize 'VARBORG.Effects.OpLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../ops selected=op localize=true}}</select>
    <input type="number" step="1" data-effect-field="value" value="{{value}}" aria-label="{{localize 'VARBORG.Effects.ValueLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>
    {{/if}}
    {{#if isRoll}}
    <select data-effect-field="roll" aria-label="{{localize 'VARBORG.Effects.RollLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../rolls selected=roll localize=true}}</select>
    <select data-effect-field="ability" aria-label="{{localize 'VARBORG.Effects.AbilityLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../abilities selected=ability localize=true}}</select>
    <select data-effect-field="against" data-tooltip="{{localize 'VARBORG.Effects.AgainstHint'}}" aria-label="{{localize 'VARBORG.Effects.AgainstLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../conditions selected=against localize=true}}</select>
    <select data-effect-field="weapon" data-tooltip="{{localize 'VARBORG.Effects.WeaponHint'}}" aria-label="{{localize 'VARBORG.Effects.WeaponLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../weapons selected=weapon localize=true}}</select>
    <select data-effect-field="damageType" data-tooltip="{{localize 'VARBORG.Effects.DamageTypeHint'}}" aria-label="{{localize 'VARBORG.Effects.DamageTypeLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../damageTypes selected=damageType localize=true}}</select>
    <select data-effect-field="vs" data-tooltip="{{localize 'VARBORG.Effects.VersusHint'}}" aria-label="{{localize 'VARBORG.Effects.VersusLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../versusList selected=vs localize=true}}</select>
    <select data-effect-field="grant" aria-label="{{localize 'VARBORG.Effects.GrantLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../grants selected=grant localize=true}}</select>
    <label class="effect-small" data-tooltip="{{localize 'VARBORG.Effects.DrHint'}}">
      <span>{{localize "VARBORG.Effects.DrLabel"}}</span>
      <input type="number" step="1" data-effect-field="dr" value="{{dr}}" {{#unless @root.editable}}disabled{{/unless}}>
    </label>
    <label class="effect-small" data-tooltip="{{localize 'VARBORG.Effects.DamageHint'}}">
      <span>{{localize "VARBORG.Effects.DamageLabel"}}</span>
      <input type="text" data-effect-field="damage" value="{{damage}}" placeholder="d4" {{#unless @root.editable}}disabled{{/unless}}>
    </label>
    <select data-effect-field="per" aria-label="{{localize 'VARBORG.Effects.PerLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../pers selected=per localize=true}}</select>
    {{#if perWound}}
    <label class="effect-small" data-tooltip="{{localize 'VARBORG.Effects.UpToHint'}}">
      <span>{{localize "VARBORG.Effects.UpToLabel"}}</span>
      <input type="number" step="1" min="0" data-effect-field="value" value="{{value}}" {{#unless @root.editable}}disabled{{/unless}}>
    </label>
    {{/if}}
    <label class="effect-small" data-tooltip="{{localize 'VARBORG.Effects.RerollOnesHint'}}">
      <input type="checkbox" data-effect-field="rerollOnes" {{checked rerollOnes}} {{#unless @root.editable}}disabled{{/unless}}>
      <span>{{localize "VARBORG.Effects.RerollOnesLabel"}}</span>
    </label>
    <select data-effect-field="requires" aria-label="{{localize 'VARBORG.Effects.RequiresLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../rollRequireList selected=requires localize=true}}</select>
    <select data-effect-field="mode" data-tooltip="{{localize 'VARBORG.Effects.ModeHint'}}" aria-label="{{localize 'VARBORG.Effects.ModeLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../modes selected=mode localize=true}}</select>
    {{/if}}
    {{#if isHook}}
    <select data-effect-field="event" aria-label="{{localize 'VARBORG.Effects.EventLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../events selected=event localize=true}}</select>
    <select data-effect-field="action" aria-label="{{localize 'VARBORG.Effects.ActionLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../actions selected=action localize=true}}</select>
    {{#if hasAmount}}
    <label class="effect-small" data-tooltip="{{localize 'VARBORG.Effects.AmountHint'}}">
      <span>{{localize "VARBORG.Effects.AmountLabel"}}</span>
      <input type="text" data-effect-field="amount" value="{{amount}}" placeholder="d4" {{#unless @root.editable}}disabled{{/unless}}>
    </label>
    {{/if}}
    {{#if hasCondition}}
    <select data-effect-field="condition" aria-label="{{localize 'VARBORG.Effects.ConditionLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../hookConditions selected=condition localize=true}}</select>
    {{/if}}
    {{#if hasKeep}}
    <select data-effect-field="keep" aria-label="{{localize 'VARBORG.Effects.KeepLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../keeps selected=keep localize=true}}</select>
    {{/if}}
    <select data-effect-field="requires" aria-label="{{localize 'VARBORG.Effects.RequiresLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../requireList selected=requires localize=true}}</select>
    <select data-effect-field="mode" data-tooltip="{{localize 'VARBORG.Effects.HookModeHint'}}" aria-label="{{localize 'VARBORG.Effects.ModeLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../hookModes selected=mode localize=true}}</select>
    {{/if}}
    {{#if isChoice}}
    <select data-effect-field="choose" aria-label="{{localize 'VARBORG.Effects.Choice.KindLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../choiceKinds selected=choose localize=true}}</select>
    {{#if choiceHasFrom}}
    <select data-effect-field="from" aria-label="{{localize 'VARBORG.Effects.Choice.FromLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../choiceFrom selected=from localize=true}}</select>
    {{/if}}
    {{#if choiceIsSpell}}
    <label class="effect-small" data-tooltip="{{localize 'VARBORG.Effects.Choice.MaxCostHint'}}">
      <span>{{localize "VARBORG.Effects.Choice.MaxCost"}}</span>
      <input type="number" step="1" min="0" data-effect-field="value" value="{{value}}" {{#unless @root.editable}}disabled{{/unless}}>
    </label>
    {{/if}}
    <span class="effect-chosen">{{#if chosenName}}{{localize "VARBORG.Effects.Choice.Chosen" name=chosenName}}{{else}}{{localize "VARBORG.Effects.Choice.NotYet"}}{{/if}}</span>
    {{#if ../canChoose}}
    <button type="button" data-action="chooseEffect" data-tooltip="{{localize 'VARBORG.Effects.Choice.ChooseHint'}}"><i class="fa-solid fa-hand-pointer"></i> {{localize "VARBORG.Effects.Choice.Choose"}}</button>
    {{/if}}
    {{/if}}
    {{#if isGift}}
    <label class="effect-wide" data-tooltip="{{localize 'VARBORG.Effects.GiftHint'}}">
      <span>{{localize "VARBORG.Effects.GiftLabel"}}</span>
      <input type="text" data-effect-field="gift" value="{{gift}}" placeholder="Compendium.var-borg.relics.Item.…" {{#unless @root.editable}}disabled{{/unless}}>
    </label>
    {{/if}}
    {{#if isResist}}
    <select data-effect-field="resist" aria-label="{{localize 'VARBORG.Effects.ResistLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../resistModes selected=resist localize=true}}</select>
    <select data-effect-field="damageType" data-tooltip="{{localize 'VARBORG.Effects.ResistTypeHint'}}" aria-label="{{localize 'VARBORG.Effects.DamageTypeLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../resistTypes selected=damageType localize=true}}</select>
    <select data-effect-field="vs" aria-label="{{localize 'VARBORG.Effects.VersusLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../versusList selected=vs localize=true}}</select>
    {{#if resistReduce}}
    <label class="effect-small" data-tooltip="{{localize 'VARBORG.Effects.AmountHint'}}">
      <span>{{localize "VARBORG.Effects.AmountLabel"}}</span>
      <input type="text" data-effect-field="amount" value="{{amount}}" placeholder="d6" {{#unless @root.editable}}disabled{{/unless}}>
    </label>
    {{/if}}
    {{/if}}
    {{#if isUse}}
    <select data-effect-field="action" data-tooltip="{{localize 'VARBORG.Effects.UseHint'}}" aria-label="{{localize 'VARBORG.Effects.ActionLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../useActions selected=action localize=true}}</select>
    {{#if hasAmount}}
    <label class="effect-small" data-tooltip="{{localize 'VARBORG.Effects.AmountHint'}}">
      <span>{{localize "VARBORG.Effects.AmountLabel"}}</span>
      <input type="text" data-effect-field="amount" value="{{amount}}" placeholder="d4" {{#unless @root.editable}}disabled{{/unless}}>
    </label>
    {{/if}}
    {{#if hasCondition}}
    <select data-effect-field="condition" aria-label="{{localize 'VARBORG.Effects.ConditionLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../hookConditions selected=condition localize=true}}</select>
    {{/if}}
    {{#if isReroll}}
    <select data-effect-field="roll" data-tooltip="{{localize 'VARBORG.Effects.RerollHint'}}" aria-label="{{localize 'VARBORG.Effects.RollLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../rerollRolls selected=roll localize=true}}</select>
    <select data-effect-field="requires" data-tooltip="{{localize 'VARBORG.Effects.CardWhenHint'}}" aria-label="{{localize 'VARBORG.Effects.RequiresLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../cardRequireList selected=requires localize=true}}</select>
    <select data-effect-field="ability" aria-label="{{localize 'VARBORG.Effects.AbilityLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../abilities selected=ability localize=true}}</select>
    {{#if isRerollOnly}}
    <select data-effect-field="failAgain" data-tooltip="{{localize 'VARBORG.Effects.FailAgainHint'}}" aria-label="{{localize 'VARBORG.Effects.FailAgainLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../failAgainList selected=failAgain localize=true}}</select>
    {{/if}}
    {{/if}}
    {{/if}}
    {{#if isReminder}}
    <select data-effect-field="roll" aria-label="{{localize 'VARBORG.Effects.RollLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../rolls selected=roll localize=true}}</select>
    <select data-effect-field="requires" aria-label="{{localize 'VARBORG.Effects.RequiresLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions ../rollRequireList selected=requires localize=true}}</select>
    {{/if}}
    <input class="effect-note" type="text" data-effect-field="note" value="{{note}}" placeholder="{{localize 'VARBORG.Effects.NotePlaceholder'}}" aria-label="{{localize 'VARBORG.Effects.NoteLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>
    {{#if @root.editable}}
    <button type="button" class="effect-remove" data-action="removeEffect" data-tooltip="{{localize 'VARBORG.Effects.Remove'}}"><i class="fa-solid fa-trash"></i></button>
    {{/if}}
  </div>
  {{/each}}
  {{/with}}
</section>

<header class="var-borg-item-header">
  <img class="item-img" src="{{item.img}}" alt="{{item.name}}" data-action="editImage" data-edit="img">
  <div class="item-title">
    <input class="item-name" type="text" name="name" value="{{item.name}}" placeholder="{{localize 'VARBORG.Sheet.Name'}}">
    {{#if forFoe}}
    <p class="hint">{{localize "VARBORG.Foe.AttackHint"}}</p>
    {{else}}
    <div class="item-meta">
      <label>
        <span>{{localize "VARBORG.Item.Price"}}</span>
        <input type="number" name="system.price" value="{{system.price}}" min="0" step="1">
      </label>
      {{#if canEquip}}
      <label>
        <input type="checkbox" data-equip-toggle {{checked system.equipped}}>
        <span>{{localize "VARBORG.Item.Equipped"}}</span>
      </label>
      {{/if}}
      <label data-tooltip="{{localize 'VARBORG.Equipment.WornAsHint'}}">
        <span>{{localize "VARBORG.Equipment.WornAsLabel"}}</span>
        <select name="system.wornAs">{{selectOptions wornAsChoices selected=system.wornAs localize=true}}</select>
      </label>
      <label data-tooltip="{{localize 'VARBORG.Item.CumbersomeHint'}}">
        <input type="checkbox" name="system.cumbersome" {{checked system.cumbersome}}>
        <span>{{localize "VARBORG.Item.Cumbersome"}}</span>
      </label>
    </div>
    {{/if}}
  </div>
</header>

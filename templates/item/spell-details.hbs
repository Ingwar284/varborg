<section class="var-borg-item-details">
  {{#if scrollHint}}<p class="hint">{{localize scrollHint}}</p>{{/if}}
  <div class="field-grid">
    <label data-tooltip="{{localize 'VARBORG.Spell.SpellListHint'}}">
      <span>{{localize "VARBORG.Spell.SpellList"}}</span>
      <select name="system.spellList">{{selectOptions spellLists selected=system.spellList localize=true}}</select>
    </label>
    {{#unless scrollHint}}
    <label data-tooltip="{{localize 'VARBORG.Spell.RitualHint'}}">
      <input type="checkbox" name="system.ritual" {{checked system.ritual}}>
      <span>{{localize "VARBORG.Spell.Ritual"}}</span>
    </label>
    {{/unless}}
    {{#if isRitual}}
    <label data-tooltip="{{localize 'VARBORG.Spell.RitualDrHint'}}">
      <span>{{localize "VARBORG.Test.DR"}}</span>
      <select name="system.ritualDr">{{selectOptions ritualDrs selected=system.ritualDr}}</select>
    </label>
    <label data-tooltip="{{localize 'VARBORG.Spell.RitualTimeHint'}}">
      <span>{{localize "VARBORG.Spell.RitualTime"}}</span>
      <input type="text" name="system.castingTime" value="{{system.castingTime}}" placeholder="10 minutes">
    </label>
    {{else}}
    <label data-tooltip="{{localize 'VARBORG.Power.CostHint'}}">
      <span>{{localize "VARBORG.Power.Cost"}}</span>
      <input type="number" name="system.cost" value="{{system.cost}}" min="0" step="1">
    </label>
    <label data-tooltip="{{localize 'VARBORG.Power.ActionsHint'}}">
      <span>{{localize "VARBORG.Power.Actions"}}</span>
      <input type="number" name="system.actions" value="{{system.actions}}" min="0" max="3" step="1">
    </label>
    {{/if}}
    <label data-tooltip="{{localize 'VARBORG.Spell.DamageHint'}}">
      <span>{{localize "VARBORG.Power.Damage"}}</span>
      <input type="text" name="system.damage" value="{{system.damage}}" placeholder="d8">
    </label>
    <label data-tooltip="{{localize 'VARBORG.Power.DamageTypeHint'}}">
      <span>{{localize "VARBORG.Power.DamageType"}}</span>
      <select name="system.damageType">{{selectOptions damageTypes selected=system.damageType localize=true}}</select>
    </label>
    {{#unless isRitual}}
    <label data-tooltip="{{localize 'VARBORG.Power.SustainedHint'}}">
      <input type="checkbox" name="system.sustained" {{checked system.sustained}}>
      <span>{{localize "VARBORG.Power.SustainedLabel"}}</span>
    </label>
    {{#unless scrollHint}}
    <label data-tooltip="{{localize 'VARBORG.Power.ReactionHint'}}">
      <input type="checkbox" name="system.reaction" {{checked system.reaction}}>
      <span>{{localize "VARBORG.Power.ReactionLabel"}}</span>
    </label>
    {{/unless}}
    {{/unless}}
  </div>
  <p class="hint">{{drHint}}</p>
  <fieldset>
    <legend>{{localize "VARBORG.Power.OutcomesLabel"}}</legend>
    <p class="hint">{{localize "VARBORG.Spell.OutcomesHint"}}</p>
    {{#each outcomes}}
    <label>
      <span>{{localize label}}</span>
      <input type="text" name="system.outcomes.{{key}}" value="{{value}}" placeholder="{{placeholder}}">
    </label>
    {{/each}}
  </fieldset>
</section>

<section class="tab var-borg-sheet {{tabs.powers.cssClass}}" data-group="primary" data-tab="powers">
  <section class="inventory-section powers">
    <div class="section-header"><h2>{{localize "VARBORG.Sheet.Powers"}}</h2><button type="button" class="add-item header-add" data-action="createItem" data-type="power" data-tooltip="{{localize 'VARBORG.Sheet.AddTooltip'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "VARBORG.Sheet.Add"}}</button></div>
    {{#if dancePartner}}<p class="hint">{{dancePartner}}</p>{{/if}}
    <ul class="item-list">
      {{#each powers}}
      <li class="item-row feat-row power-row" data-item-id="{{item.id}}">
        <button type="button" class="item-icon" data-action="postItem" data-tooltip="{{localize 'VARBORG.Sheet.PostItem'}}" aria-label="{{localize 'VARBORG.Sheet.PostItem'}}"><img src="{{item.img}}" alt=""></button>
        <span class="feat-text"><button type="button" class="link-button" data-action="toggleDescription"><strong>{{item.name}}</strong></button> <span class="item-summary">{{summary}}</span>
          {{#if item.system.sustaining}}<span class="item-state sustaining">{{localize "VARBORG.Power.Sustaining"}}</span>{{/if}}
          {{#if item.system.usedOutside}}<span class="item-state used-outside" data-tooltip="{{localize 'VARBORG.Power.UsedOutsideHint'}}">{{localize "VARBORG.Power.UsedOutside"}}</span>{{/if}}</span>
        {{#if item.system.sustaining}}
        <button type="button" class="text-button" data-action="sustainPower" data-tooltip="{{localize 'VARBORG.Power.SustainTooltip'}}">
          ◈ {{localize "VARBORG.Power.Sustain"}}
        </button>
        <button type="button" class="text-button" data-action="endPower" data-tooltip="{{localize 'VARBORG.Power.EndTooltip'}}">
          {{localize "VARBORG.Power.End"}}
        </button>
        {{/if}}
        <button type="button" class="icon-button" data-action="usePower"
                data-tooltip="{{localize 'VARBORG.Power.UseTooltip'}}" aria-label="{{localize 'VARBORG.Power.UseTooltip'}}">
          <i class="fa-solid fa-fire"></i>
        </button>
        <button type="button" class="icon-button" data-action="editItem"
                data-tooltip="{{localize 'VARBORG.Sheet.Equipment.Edit'}}" aria-label="{{localize 'VARBORG.Sheet.Equipment.Edit'}}">
          <i class="fa-solid fa-pen"></i>
        </button>
        <button type="button" class="icon-button" data-action="deleteItem"
                data-tooltip="{{localize 'VARBORG.Sheet.Equipment.Delete'}}" aria-label="{{localize 'VARBORG.Sheet.Equipment.Delete'}}">
          <i class="fa-solid fa-trash"></i>
        </button>
      </li>
      {{> "systems/var-borg/templates/actor/item-description-row.hbs"}}
      {{else}}
      <li class="empty">{{localize "VARBORG.Sheet.Equipment.None"}}</li>
      {{/each}}
    </ul>
  </section>

  <section class="inventory-section spells">
    <div class="section-header"><h2>{{localize "VARBORG.Sheet.Spells"}}</h2><button type="button" class="add-item header-add" data-action="createItem" data-type="spell" data-tooltip="{{localize 'VARBORG.Sheet.AddTooltip'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "VARBORG.Sheet.Add"}}</button></div>
    <ul class="item-list">
      {{#each spells}}
      <li class="item-row feat-row power-row spell-row" data-item-id="{{item.id}}">
        <button type="button" class="item-icon" data-action="postItem" data-tooltip="{{localize 'VARBORG.Sheet.PostItem'}}" aria-label="{{localize 'VARBORG.Sheet.PostItem'}}"><img src="{{item.img}}" alt=""></button>
        <span class="feat-text"><button type="button" class="link-button" data-action="toggleDescription"><strong>{{item.name}}</strong></button> <span class="item-summary">{{summary}}</span>
          {{#if item.system.sustaining}}<span class="item-state sustaining">{{localize "VARBORG.Power.Sustaining"}}</span>{{/if}}
          {{#if item.system.usedOutside}}<span class="item-state used-outside" data-tooltip="{{localize 'VARBORG.Power.UsedOutsideHint'}}">{{localize "VARBORG.Power.UsedOutside"}}</span>{{/if}}</span>
        {{#if item.system.sustaining}}
        <button type="button" class="text-button" data-action="sustainPower" data-tooltip="{{localize 'VARBORG.Power.SustainTooltip'}}">
          ◈ {{localize "VARBORG.Power.Sustain"}}
        </button>
        <button type="button" class="text-button" data-action="endPower" data-tooltip="{{localize 'VARBORG.Power.EndTooltip'}}">
          {{localize "VARBORG.Power.End"}}
        </button>
        {{/if}}
        <button type="button" class="icon-button" data-action="castSpell"
                data-tooltip="{{localize 'VARBORG.Spell.CastTooltip'}}" aria-label="{{localize 'VARBORG.Spell.CastTooltip'}}">
          <i class="fa-solid fa-wand-sparkles"></i>
        </button>
        <button type="button" class="icon-button" data-action="editItem"
                data-tooltip="{{localize 'VARBORG.Sheet.Equipment.Edit'}}" aria-label="{{localize 'VARBORG.Sheet.Equipment.Edit'}}">
          <i class="fa-solid fa-pen"></i>
        </button>
        <button type="button" class="icon-button" data-action="deleteItem"
                data-tooltip="{{localize 'VARBORG.Sheet.Equipment.Delete'}}" aria-label="{{localize 'VARBORG.Sheet.Equipment.Delete'}}">
          <i class="fa-solid fa-trash"></i>
        </button>
      </li>
      {{> "systems/var-borg/templates/actor/item-description-row.hbs"}}
      {{else}}
      <li class="empty">{{localize "VARBORG.Sheet.Equipment.None"}}</li>
      {{/each}}
    </ul>
  </section>
</section>

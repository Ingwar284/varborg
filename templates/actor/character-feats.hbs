<section class="tab var-borg-sheet {{tabs.feats.cssClass}}" data-group="primary" data-tab="feats">
  <section class="inventory-section">
    <div class="section-header"><h2>{{localize "VARBORG.Sheet.Feats"}}</h2><button type="button" class="add-item header-add" data-action="createItem" data-type="feat" data-tooltip="{{localize 'VARBORG.Sheet.AddTooltip'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "VARBORG.Sheet.Add"}}</button></div>
    {{#if choosingFeat}}
    <p class="improving-choice">
      <span>{{localize "VARBORG.Improving.Choose"}}</span>
      <button type="button" class="text-button" data-action="rollImprovingFeat" data-tooltip="{{localize 'VARBORG.Improving.RollFeatTooltip'}}">
        {{localize "VARBORG.Improving.RollFeat"}}
      </button>
      <button type="button" class="text-button" data-action="skipFeat" data-tooltip="{{localize 'VARBORG.Improving.SkipTooltip'}}">
        {{localize "VARBORG.Improving.Skip"}}
      </button>
    </p>
    {{/if}}
    {{#if reading}}
    <div class="reading">
      <h3>{{localize "VARBORG.Arcana.Heading"}}
        {{#if reading.canShuffle}}<button type="button" class="text-button" data-action="shuffleFates" data-tooltip="{{localize 'VARBORG.Arcana.ShuffleTooltip'}}">{{localize "VARBORG.Arcana.Shuffle"}}</button>{{/if}}</h3>
      {{#if reading.empty}}
      <p class="hint">{{localize "VARBORG.Arcana.Empty"}}
        <button type="button" class="text-button" data-action="layReading">{{localize "VARBORG.Arcana.LayOut"}}</button></p>
      {{/if}}
      <ul class="item-list">
        {{#each reading.cards}}
        <li class="item-row feat-row{{#if turned}} used-up{{/if}}">
          <span class="feat-text"><strong>{{name}}</strong> <span class="item-summary">{{meaning}}</span>
            {{#if turned}} <span class="item-state used">{{localize "VARBORG.Arcana.Turned"}}</span>{{/if}}</span>
          {{#if canTurn}}
          <button type="button" class="icon-button" data-action="turnReading" data-index="{{index}}"
                  data-tooltip="{{localize 'VARBORG.Arcana.TurnTooltip'}}" aria-label="{{localize 'VARBORG.Arcana.TurnTooltip'}}">
            <i class="fa-solid fa-rotate"></i>
          </button>
          {{/if}}
          {{#if canReverse}}
          <button type="button" class="icon-button" data-action="reverseReading" data-index="{{index}}"
                  data-tooltip="{{localize 'VARBORG.Arcana.ReverseTooltip'}}" aria-label="{{localize 'VARBORG.Arcana.ReverseTooltip'}}">
            <i class="fa-solid fa-arrows-up-down"></i>
          </button>
          {{/if}}
          {{#if canTear}}
          <button type="button" class="icon-button" data-action="tearThirteenth"
                  data-tooltip="{{localize 'VARBORG.Arcana.TearTooltip'}}" aria-label="{{localize 'VARBORG.Arcana.TearTooltip'}}">
            <i class="fa-solid fa-scissors"></i>
          </button>
          {{/if}}
          {{#if canDarkMaster}}
          <button type="button" class="icon-button" data-action="dmThirteenth"
                  data-tooltip="{{localize 'VARBORG.Arcana.DmTooltip'}}" aria-label="{{localize 'VARBORG.Arcana.DmTooltip'}}">
            <i class="fa-solid fa-skull"></i>
          </button>
          {{/if}}
        </li>
        {{/each}}
      </ul>
    </div>
    {{/if}}
    <ul class="item-list">
      {{#each feats}}
      <li class="item-row feat-row" data-item-id="{{item.id}}">
        <button type="button" class="item-icon" data-action="postItem" data-tooltip="{{localize 'VARBORG.Sheet.PostItem'}}" aria-label="{{localize 'VARBORG.Sheet.PostItem'}}"><img src="{{item.img}}" alt=""></button>
        <span class="feat-text"><button type="button" class="link-button" data-action="toggleDescription"><strong>{{item.name}}</strong></button> <span class="item-summary">{{summary}}</span>
          {{#each states}} <span class="item-state {{key}}">{{localize label}}</span>{{/each}}</span>
        {{> "systems/var-borg/templates/actor/use-button.hbs"}}
        <button type="button" class="icon-button" data-action="editItem"
                data-tooltip="{{localize 'VARBORG.Sheet.Equipment.Edit'}}" aria-label="{{localize 'VARBORG.Sheet.Equipment.Edit'}}">
          <i class="fa-solid fa-pen"></i>
        </button>
        <button type="button" class="icon-button" data-action="deleteItem"
                data-tooltip="{{localize 'VARBORG.Sheet.Equipment.Delete'}}" aria-label="{{localize 'VARBORG.Sheet.Equipment.Delete'}}">
          <i class="fa-solid fa-trash"></i>
        </button>
      </li>
      {{> "systems/var-borg/templates/actor/item-description-row.hbs"}}
      {{else}}
      <li class="empty">{{localize "VARBORG.Sheet.Equipment.None"}}</li>
      {{/each}}
    </ul>
  </section>
</section>

<section class="conditions-section">
  <h2>{{localize "VARBORG.Condition.Title"}}</h2>
  <ul class="condition-list">
    {{#each conditions.list}}
    <li class="condition-row">
      <img src="{{img}}" alt="">
      <span class="condition-text"><strong>{{label}}</strong>{{#if timer}} <span class="condition-timer">({{timer}})</span>{{/if}} {{text}}</span>
      {{#if canTime}}
      <button type="button" class="icon-button" data-time-condition="{{id}}"
              data-tooltip="{{localize 'VARBORG.Timer.Button'}}" aria-label="{{localize 'VARBORG.Timer.Button'}}">
        <i class="fa-solid fa-hourglass-half"></i>
      </button>
      {{/if}}
      <button type="button" class="icon-button" data-remove-condition="{{id}}"
              data-tooltip="{{localize 'VARBORG.Condition.Remove'}}" aria-label="{{localize 'VARBORG.Condition.Remove'}}">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </li>
    {{/each}}
    {{#each conditions.persistent.list}}
    <li class="condition-row">
      <img src="{{img}}" alt="">
      <span class="condition-text"><strong>{{label}}</strong> {{text}}</span>
      <button type="button" class="icon-button" data-remove-persistent="{{id}}"
              data-tooltip="{{localize 'VARBORG.Condition.Remove'}}" aria-label="{{localize 'VARBORG.Condition.Remove'}}">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </li>
    {{/each}}
    {{#each conditions.panic.list}}
    <li class="condition-row panic-row">
      <img src="{{img}}" alt="">
      <span class="condition-text"><strong>{{label}}</strong> {{text}}</span>
      <button type="button" class="icon-button" data-remove-panic="{{id}}"
              data-tooltip="{{localize 'VARBORG.Panic.Remove'}}" aria-label="{{localize 'VARBORG.Panic.Remove'}}">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </li>
    {{/each}}
    {{#each conditions.injuries}}
    <li class="condition-row injury-row">
      <img src="{{img}}" alt="">
      <span class="condition-text"><strong>{{label}}</strong> {{text}}</span>
      <button type="button" class="icon-button" data-remove-injury="{{id}}"
              data-tooltip="{{localize 'VARBORG.Agony.Remove'}}" aria-label="{{localize 'VARBORG.Agony.Remove'}}">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </li>
    {{/each}}
    {{#unless conditions.list.length}}{{#unless conditions.persistent.list.length}}{{#unless conditions.panic.list.length}}{{#unless conditions.injuries.length}}
    <li class="empty">{{localize "VARBORG.Condition.None"}}</li>
    {{/unless}}{{/unless}}{{/unless}}{{/unless}}
  </ul>
  <div class="condition-controls">
    <select data-add-condition aria-label="{{localize 'VARBORG.Condition.Add'}}">
      <option value="">{{localize "VARBORG.Condition.Add"}}</option>
      {{#each conditions.choices}}<option value="{{id}}">{{label}}</option>{{/each}}
    </select>
    <label data-tooltip="{{localize 'VARBORG.Condition.FatigueHint'}}">
      <span>{{localize "VARBORG.Condition.FatigueLevel"}}</span>
      <input type="number" name="system.fatigue" value="{{conditions.fatigue}}" min="0" step="1">
    </label>
  </div>
  <div class="condition-controls persistent-controls">
    <span>{{localize "VARBORG.Persistent.Label"}}</span>
    <select data-persistent-type aria-label="{{localize 'VARBORG.Persistent.TypeLabel'}}">
      {{#each conditions.persistent.types}}<option value="{{id}}">{{label}}</option>{{/each}}
    </select>
    <input type="text" data-persistent-formula value="d4" placeholder="d4"
           aria-label="{{localize 'VARBORG.Persistent.FormulaLabel'}}" data-tooltip="{{localize 'VARBORG.Persistent.FormulaHint'}}">
    <button type="button" data-add-persistent>{{localize "VARBORG.Persistent.Add"}}</button>
    {{#if conditions.persistent.canTick}}
    <button type="button" data-tick-persistent data-tooltip="{{localize 'VARBORG.Persistent.TickHint'}}">{{localize "VARBORG.Persistent.Tick"}}</button>
    {{/if}}
  </div>
  {{#with conditions.deathsDoor}}
  <div class="deaths-door-panel">
    <h3>{{localize "VARBORG.DeathsDoor.Title"}}</h3>
    {{#if status}}<p class="deaths-door-status">{{status}}</p>{{/if}}
    <div class="condition-controls">
      {{#if canRoll}}<button type="button" data-roll-deaths-door>{{localize "VARBORG.DeathsDoor.RollButton"}}</button>{{/if}}
      {{#if canWake}}<button type="button" data-wake data-tooltip="{{localize 'VARBORG.DeathsDoor.WakeHint'}}">{{localize "VARBORG.DeathsDoor.Wake"}}</button>{{/if}}
      <label data-tooltip="{{localize 'VARBORG.DeathsDoor.VesselHint'}}">
        <span>{{localize "VARBORG.DeathsDoor.VesselCount"}}</span>
        <input type="number" name="system.darkVessels" value="{{darkVessels}}" min="0" step="1" {{#unless isGM}}disabled{{/unless}}>
      </label>
    </div>
    {{#if lostParts.length}}
    <ul class="condition-list">
      {{#each lostParts}}
      <li class="condition-row injury-row">
        <img src="{{img}}" alt="">
        <span class="condition-text"><strong>{{label}}</strong> {{text}}</span>
        <button type="button" class="icon-button" data-remove-part="{{id}}"
                data-tooltip="{{localize 'VARBORG.DeathsDoor.RemovePart'}}" aria-label="{{localize 'VARBORG.DeathsDoor.RemovePart'}}">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </li>
      {{/each}}
    </ul>
    {{/if}}
  </div>
  {{/with}}
  {{#if conditions.panic.choices}}
  <div class="condition-controls">
    <select data-add-panic aria-label="{{localize 'VARBORG.Panic.Add'}}" data-tooltip="{{localize 'VARBORG.Panic.AddHint'}}">
      <option value="">{{localize "VARBORG.Panic.Add"}}</option>
      {{#each conditions.panic.choices}}<option value="{{id}}">{{label}}</option>{{/each}}
    </select>
  </div>
  {{/if}}
</section>

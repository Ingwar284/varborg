{{!-- A max box: the max in use over the stored max while bonuses add to it. --}}
{{#*inline "boostedMax"}}
{{#if box.note}}
<span class="boosted-box" data-tooltip="{{box.boxHint}}">
  <input type="number" name="{{name}}" value="{{box.value}}" min="0" step="1">
  <span class="boosted-total" aria-hidden="true">{{box.total}}</span>
</span>
{{else}}
<input type="number" name="{{name}}" value="{{box.value}}" min="0" step="1">
{{/if}}
{{/inline}}
<section class="tab var-borg-sheet {{tabs.main.cssClass}}" data-group="primary" data-tab="main">
  <section class="abilities">
    <h2>{{localize "VARBORG.Sheet.Abilities"}}</h2>
    <div class="ability-row">
      {{#each abilities}}
      <div class="ability">
        <button type="button" class="ability-roll" data-action="rollAbility" data-ability="{{key}}"
                data-tooltip="{{localize 'VARBORG.Test.RollTooltip'}}">
          <i class="fa-solid fa-dice-d20"></i> {{localize label}}
        </button>
        {{!-- The score box with − on its left and + on its right. --}}
        <div class="ability-score">
          <button type="button" class="ability-step" data-action="adjustAbility" data-ability="{{key}}" data-step="-1"
                  data-tooltip="{{lowerHint}}" aria-label="{{lowerHint}}">−</button>
          {{!-- Every box shows its score signed, such as "+2"; the input underneath
                keeps the rolled score, shown while it is being edited. --}}
          <span class="boosted-box" data-tooltip="{{#if note}}{{boxHint}}{{else}}{{localize 'VARBORG.Sheet.RolledHint'}}{{/if}}">
            <input type="number" name="system.abilities.{{key}}" value="{{value}}" min="-3" max="6" step="1" aria-label="{{localize label}}">
            <span class="boosted-total" aria-hidden="true">{{shown}}</span>
          </span>
          <button type="button" class="ability-step" data-action="adjustAbility" data-ability="{{key}}" data-step="1"
                  data-tooltip="{{raiseHint}}" aria-label="{{raiseHint}}">+</button>
        </div>
        {{#if note}}<span class="ability-in-use">{{note}}</span>{{/if}}
      </div>
      {{/each}}
    </div>
    <div class="other-rolls">
      <button type="button" data-action="rollContest" data-tooltip="{{localize 'VARBORG.Contest.Tooltip'}}">
        <i class="fa-solid fa-people-arrows"></i> {{localize "VARBORG.Contest.Button"}}
      </button>
      <button type="button" data-action="rollChance" data-tooltip="{{localize 'VARBORG.Chance.Tooltip'}}">
        <i class="fa-solid fa-dice"></i> {{localize "VARBORG.Chance.Button"}}
      </button>
      <button type="button" data-action="rollPanic" data-tooltip="{{localize 'VARBORG.Panic.Tooltip'}}">
        <i class="fa-solid fa-face-flushed"></i> {{localize "VARBORG.Panic.Button"}}
      </button>
    </div>
  </section>

  <section class="resources">
    <label class="resource" {{#if hpHint}}data-tooltip="{{hpHint}}"{{/if}}>
      <span>{{localize "VARBORG.Sheet.HP"}}</span>
      <span class="pair">
        <input type="number" name="system.hp.value" value="{{system.hp.value}}" min="0" step="1">
        <span>/</span>
        {{> boostedMax box=maxes.hp name="system.hp.max"}}
      </span>
      {{#if maxes.hp.note}}<span class="ability-in-use">{{maxes.hp.note}}</span>{{/if}}
    </label>
    <label class="resource">
      <span>{{localize "VARBORG.Sheet.Wounds"}}</span>
      <span class="pair">
        <input type="number" name="system.wounds.value" value="{{system.wounds.value}}" min="0" step="1">
        <span>/</span>
        {{> boostedMax box=maxes.wounds name="system.wounds.max"}}
      </span>
      {{#if maxes.wounds.note}}<span class="ability-in-use">{{maxes.wounds.note}}</span>{{/if}}
    </label>
    <label class="resource">
      <span>{{localize "VARBORG.Sheet.Fortune"}}</span>
      <input type="number" name="system.fortune" value="{{system.fortune}}" min="0" step="1">
    </label>
    <div class="resource movement carrying-{{carrying.state}}" data-tooltip="{{localize (concat 'VARBORG.Carrying.Hint.' carrying.state)}}">
      <span>{{localize "VARBORG.Carrying.Movement"}}</span>
      <span class="movement-value">{{localize "VARBORG.Carrying.Feet" value=carrying.movement}}</span>
      {{#unless (eq carrying.state "normal")}}<span class="carrying-state">{{localize carrying.stateLabel}}</span>{{/unless}}
      {{#if carrying.effects}}<span class="ability-in-use">{{carrying.effects}}</span>{{/if}}
    </div>
  </section>

  {{#if conditionIcons.length}}
  <button type="button" class="condition-strip" data-action="showConditions"
          data-tooltip="{{localize 'VARBORG.Sheet.ConditionStripHint'}}" aria-label="{{localize 'VARBORG.Sheet.ConditionStripHint'}}">
    {{#each conditionIcons}}<img src="{{img}}" alt="{{label}}" data-tooltip="{{label}}">{{/each}}
  </button>
  {{/if}}

  {{> "systems/var-borg/templates/actor/character-actions.hbs"}}

  <section class="inventory-section minions">
    <h2 class="{{#if minions.over}}over-limit{{/if}}" data-tooltip="{{localize 'VARBORG.Minion.LimitHint'}}">{{minions.heading}}</h2>
    {{#if minions.effects}}<p class="hint">{{localize "VARBORG.Effects.OnMinionLimit" parts=minions.effects}}</p>{{/if}}
    <ul class="item-list">
      {{#each minions.list}}
      <li class="item-row feat-row{{#if dead}} used-up{{/if}}" data-minion-id="{{id}}">
        <img src="{{img}}" alt="">
        <span class="feat-text"><button type="button" class="link-button" data-action="openMinion"><strong>{{name}}</strong></button>
          <span class="item-summary">{{summary}}</span></span>
        <button type="button" class="text-button" data-action="commandMinion" {{#if dead}}disabled{{/if}}
                data-tooltip="{{localize 'VARBORG.Minion.CommandTooltip'}}">
          ◈ {{localize "VARBORG.Minion.Command"}}
        </button>
      </li>
      {{else}}
      <li class="empty">{{localize "VARBORG.Minion.NoneYet"}}</li>
      {{/each}}
    </ul>
  </section>
</section>

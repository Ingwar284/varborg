<section class="tab var-borg-sheet {{tabs.main.cssClass}}" data-group="primary" data-tab="main">
  <section class="inventory-section origins">
    <h2 data-tooltip="{{localize 'VARBORG.Origin.DropHint'}}">{{localize "VARBORG.Origin.Heading"}}</h2>
    <ul class="item-list">
      {{#each origins}}
      {{#if item}}
      <li class="item-row feat-row" data-item-id="{{item.id}}">
        <img src="{{item.img}}" alt="">
        <span class="feat-text"><span class="item-summary">{{localize label}}:</span> <strong>{{item.name}}</strong> <span class="item-summary">{{summary}}</span></span>
        <button type="button" class="icon-button" data-action="editItem"
                data-tooltip="{{localize 'VARBORG.Sheet.Equipment.Edit'}}" aria-label="{{localize 'VARBORG.Sheet.Equipment.Edit'}}">
          <i class="fa-solid fa-pen"></i>
        </button>
        <button type="button" class="icon-button" data-action="deleteItem"
                data-tooltip="{{localize 'VARBORG.Sheet.Equipment.Delete'}}" aria-label="{{localize 'VARBORG.Sheet.Equipment.Delete'}}">
          <i class="fa-solid fa-trash"></i>
        </button>
      </li>
      {{else}}
      <li class="empty">{{localize label}}: {{localize "VARBORG.Origin.NoneYet"}}</li>
      {{/if}}
      {{/each}}
    </ul>
  </section>

  <section class="abilities">
    <h2>{{localize "VARBORG.Sheet.Abilities"}}</h2>
    <div class="ability-row">
      {{#each abilities}}
      <div class="ability">
        <button type="button" class="ability-roll" data-action="rollAbility" data-ability="{{key}}"
                data-tooltip="{{localize 'VARBORG.Test.RollTooltip'}}">
          <i class="fa-solid fa-dice-d20"></i> {{localize label}}
        </button>
        <input type="number" name="system.abilities.{{key}}" value="{{value}}" min="-3" max="6" step="1"
               aria-label="{{localize label}}" data-tooltip="{{localize 'VARBORG.Sheet.RolledHint'}}">
        {{#if inUse}}<span class="ability-in-use">{{inUse}}</span>{{/if}}
      </div>
      {{/each}}
    </div>
    <div class="other-rolls">
      <button type="button" data-action="rollContest" data-tooltip="{{localize 'VARBORG.Contest.Tooltip'}}">
        <i class="fa-solid fa-people-arrows"></i> {{localize "VARBORG.Contest.Button"}}
      </button>
      <button type="button" data-action="rollChance" data-tooltip="{{localize 'VARBORG.Chance.Tooltip'}}">
        <i class="fa-solid fa-dice"></i> {{localize "VARBORG.Chance.Button"}}
      </button>
      <button type="button" data-action="rollPanic" data-tooltip="{{localize 'VARBORG.Panic.Tooltip'}}">
        <i class="fa-solid fa-face-flushed"></i> {{localize "VARBORG.Panic.Button"}}
      </button>
    </div>
  </section>

  <section class="resources">
    <label class="resource" {{#if hpHint}}data-tooltip="{{hpHint}}"{{/if}}>
      <span>{{localize "VARBORG.Sheet.HP"}}</span>
      <span class="pair">
        <input type="number" name="system.hp.value" value="{{system.hp.value}}" min="0" step="1">
        <span>/</span>
        <input type="number" name="system.hp.max" value="{{system.hp.max}}" min="0" step="1">
      </span>
    </label>
    <label class="resource">
      <span>{{localize "VARBORG.Sheet.Wounds"}}</span>
      <span class="pair">
        <input type="number" name="system.wounds.value" value="{{system.wounds.value}}" min="0" step="1">
        <span>/</span>
        <input type="number" name="system.wounds.max" value="{{system.wounds.max}}" min="0" step="1">
      </span>
    </label>
    <label class="resource">
      <span>{{localize "VARBORG.Sheet.Fortune"}}</span>
      <input type="number" name="system.fortune" value="{{system.fortune}}" min="0" step="1">
    </label>
    <label class="resource" data-tooltip="{{localize 'VARBORG.Panic.LostSanityHint'}}">
      <span>{{localize "VARBORG.Panic.LostSanity"}}</span>
      <input type="number" name="system.sanityLost" value="{{system.sanityLost}}" min="0" step="1">
    </label>
    <label class="resource">
      <span>{{localize "VARBORG.Sheet.Silver"}}</span>
      <input type="number" name="system.silver" value="{{system.silver}}" min="0" step="1">
    </label>
    <div class="resource movement carrying-{{carrying.state}}" data-tooltip="{{localize (concat 'VARBORG.Carrying.Hint.' carrying.state)}}">
      <span>{{localize "VARBORG.Carrying.Movement"}}</span>
      <span class="movement-value">{{localize "VARBORG.Carrying.Feet" value=carrying.movement}}</span>
      {{#unless (eq carrying.state "normal")}}<span class="carrying-state">{{localize carrying.stateLabel}}</span>{{/unless}}
    </div>
  </section>

  {{> "systems/var-borg/templates/actor/conditions.hbs"}}

  <section class="inventory-section">
    <h2>{{localize "VARBORG.Sheet.Feats"}}</h2>
    <ul class="item-list">
      {{#each feats}}
      <li class="item-row feat-row" data-item-id="{{item.id}}">
        <img src="{{item.img}}" alt="">
        <span class="feat-text"><strong>{{item.name}}</strong> <span class="item-summary">{{summary}}</span></span>
        <button type="button" class="icon-button" data-action="editItem"
                data-tooltip="{{localize 'VARBORG.Sheet.Equipment.Edit'}}" aria-label="{{localize 'VARBORG.Sheet.Equipment.Edit'}}">
          <i class="fa-solid fa-pen"></i>
        </button>
        <button type="button" class="icon-button" data-action="deleteItem"
                data-tooltip="{{localize 'VARBORG.Sheet.Equipment.Delete'}}" aria-label="{{localize 'VARBORG.Sheet.Equipment.Delete'}}">
          <i class="fa-solid fa-trash"></i>
        </button>
      </li>
      {{else}}
      <li class="empty">{{localize "VARBORG.Sheet.Equipment.None"}}</li>
      {{/each}}
    </ul>
  </section>

  <section class="inventory-section powers">
    <h2>{{localize "VARBORG.Sheet.Powers"}}</h2>
    <ul class="item-list">
      {{#each powers}}
      <li class="item-row feat-row power-row" data-item-id="{{item.id}}">
        <img src="{{item.img}}" alt="">
        <span class="feat-text"><strong>{{item.name}}</strong> <span class="item-summary">{{summary}}</span>
          {{#if item.system.sustaining}}<span class="item-state sustaining">{{localize "VARBORG.Power.Sustaining"}}</span>{{/if}}
          {{#if item.system.usedOutside}}<span class="item-state used-outside" data-tooltip="{{localize 'VARBORG.Power.UsedOutsideHint'}}">{{localize "VARBORG.Power.UsedOutside"}}</span>{{/if}}</span>
        {{#if item.system.sustaining}}
        <button type="button" class="text-button" data-action="sustainPower" data-tooltip="{{localize 'VARBORG.Power.SustainTooltip'}}">
          ◈ {{localize "VARBORG.Power.Sustain"}}
        </button>
        <button type="button" class="text-button" data-action="endPower" data-tooltip="{{localize 'VARBORG.Power.EndTooltip'}}">
          {{localize "VARBORG.Power.End"}}
        </button>
        {{/if}}
        <button type="button" class="icon-button" data-action="usePower"
                data-tooltip="{{localize 'VARBORG.Power.UseTooltip'}}" aria-label="{{localize 'VARBORG.Power.UseTooltip'}}">
          <i class="fa-solid fa-fire"></i>
        </button>
        <button type="button" class="icon-button" data-action="editItem"
                data-tooltip="{{localize 'VARBORG.Sheet.Equipment.Edit'}}" aria-label="{{localize 'VARBORG.Sheet.Equipment.Edit'}}">
          <i class="fa-solid fa-pen"></i>
        </button>
        <button type="button" class="icon-button" data-action="deleteItem"
                data-tooltip="{{localize 'VARBORG.Sheet.Equipment.Delete'}}" aria-label="{{localize 'VARBORG.Sheet.Equipment.Delete'}}">
          <i class="fa-solid fa-trash"></i>
        </button>
      </li>
      {{else}}
      <li class="empty">{{localize "VARBORG.Sheet.Equipment.None"}}</li>
      {{/each}}
    </ul>
  </section>

  <section class="inventory-section spells">
    <h2>{{localize "VARBORG.Sheet.Spells"}}</h2>
    <ul class="item-list">
      {{#each spells}}
      <li class="item-row feat-row power-row spell-row" data-item-id="{{item.id}}">
        <img src="{{item.img}}" alt="">
        <span class="feat-text"><strong>{{item.name}}</strong> <span class="item-summary">{{summary}}</span>
          {{#if item.system.sustaining}}<span class="item-state sustaining">{{localize "VARBORG.Power.Sustaining"}}</span>{{/if}}
          {{#if item.system.usedOutside}}<span class="item-state used-outside" data-tooltip="{{localize 'VARBORG.Power.UsedOutsideHint'}}">{{localize "VARBORG.Power.UsedOutside"}}</span>{{/if}}</span>
        {{#if item.system.sustaining}}
        <button type="button" class="text-button" data-action="sustainPower" data-tooltip="{{localize 'VARBORG.Power.SustainTooltip'}}">
          ◈ {{localize "VARBORG.Power.Sustain"}}
        </button>
        <button type="button" class="text-button" data-action="endPower" data-tooltip="{{localize 'VARBORG.Power.EndTooltip'}}">
          {{localize "VARBORG.Power.End"}}
        </button>
        {{/if}}
        <button type="button" class="icon-button" data-action="castSpell"
                data-tooltip="{{localize 'VARBORG.Spell.CastTooltip'}}" aria-label="{{localize 'VARBORG.Spell.CastTooltip'}}">
          <i class="fa-solid fa-wand-sparkles"></i>
        </button>
        <button type="button" class="icon-button" data-action="editItem"
                data-tooltip="{{localize 'VARBORG.Sheet.Equipment.Edit'}}" aria-label="{{localize 'VARBORG.Sheet.Equipment.Edit'}}">
          <i class="fa-solid fa-pen"></i>
        </button>
        <button type="button" class="icon-button" data-action="deleteItem"
                data-tooltip="{{localize 'VARBORG.Sheet.Equipment.Delete'}}" aria-label="{{localize 'VARBORG.Sheet.Equipment.Delete'}}">
          <i class="fa-solid fa-trash"></i>
        </button>
      </li>
      {{else}}
      <li class="empty">{{localize "VARBORG.Sheet.Equipment.None"}}</li>
      {{/each}}
    </ul>
  </section>

  <section class="details">
    <h2>{{localize "VARBORG.Sheet.Details"}}</h2>
    <label data-tooltip="{{localize 'VARBORG.Panic.PhobiasHint'}}">
      <span>{{localize "VARBORG.Panic.Phobias"}}</span>
      <textarea name="system.phobias" rows="2">{{system.phobias}}</textarea>
    </label>
    <label>
      <span>{{localize "VARBORG.Sheet.Personality"}}</span>
      <textarea name="system.details.personality" rows="2">{{system.details.personality}}</textarea>
    </label>
    <label>
      <span>{{localize "VARBORG.Sheet.PhysicalMark"}}</span>
      <textarea name="system.details.physicalMark" rows="2">{{system.details.physicalMark}}</textarea>
    </label>
    <label>
      <span>{{localize "VARBORG.Sheet.Idiosyncrasy"}}</span>
      <textarea name="system.details.idiosyncrasy" rows="2">{{system.details.idiosyncrasy}}</textarea>
    </label>
    <label>
      <span>{{localize "VARBORG.Sheet.CallToAdventure"}}</span>
      <textarea name="system.details.callToAdventure" rows="2">{{system.details.callToAdventure}}</textarea>
    </label>
  </section>
</section>

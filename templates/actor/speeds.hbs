<section class="resources foe-stats speeds" data-tooltip="{{localize 'VARBORG.Movement.CreatureHint'}}">
  <label class="resource">
    <span>{{localize "VARBORG.Movement.Type.walk"}}</span>
    <input type="number" name="system.movement.walk" value="{{system.movement.walk}}" min="0" step="5">
  </label>
  <label class="resource">
    <span>{{localize "VARBORG.Movement.Type.fly"}}</span>
    <input type="number" name="system.movement.fly" value="{{system.movement.fly}}" min="0" step="5" placeholder="–">
  </label>
  <label class="resource">
    <span>{{localize "VARBORG.Movement.Type.swim"}}</span>
    <input type="number" name="system.movement.swim" value="{{system.movement.swim}}" min="0" step="5" placeholder="–">
  </label>
  <label class="resource">
    <span>{{localize "VARBORG.Movement.Type.climb"}}</span>
    <input type="number" name="system.movement.climb" value="{{system.movement.climb}}" min="0" step="5" placeholder="–">
  </label>
</section>

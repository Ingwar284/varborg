<section class="tab var-borg-sheet {{tabs.inventory.cssClass}}" data-group="primary" data-tab="inventory">
  {{#if system.attackRuin}}
  <section class="attack-ruin">
    <p><strong>{{localize "VARBORG.Attack.RuinedTitle"}}</strong> {{localize "VARBORG.Attack.RuinedHint"}}</p>
    <button type="button" data-action="recover">
      <i class="fa-solid fa-hand-fist"></i> {{localize "VARBORG.Attack.Recover"}}
    </button>
  </section>
  {{/if}}

  {{#if raisedShield}}
  <section class="shield-raised">
    <p><strong>{{localize "VARBORG.Defence.RaisedTitle"}}</strong> {{raisedShield}}</p>
    <button type="button" data-action="lowerShield">
      <i class="fa-solid fa-shield"></i> {{localize "VARBORG.Defence.Lower"}}
    </button>
  </section>
  {{/if}}

  {{#each inventory as |section|}}
  <section class="inventory-section">
    <div class="section-header"><h3>{{localize section.label}}</h3><button type="button" class="add-item header-add" data-action="createItem" data-type="{{section.type}}" data-tooltip="{{localize 'VARBORG.Sheet.AddTooltip'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "VARBORG.Sheet.Add"}}</button></div>
    <ul class="item-list">
      {{#each section.items}}
      {{> "systems/var-borg/templates/actor/inventory-row.hbs"}}
      {{> "systems/var-borg/templates/actor/item-description-row.hbs"}}
      {{#each contents}}
      {{> "systems/var-borg/templates/actor/inventory-row.hbs" stored=true}}
      {{> "systems/var-borg/templates/actor/item-description-row.hbs"}}
      {{/each}}
      {{else}}
      {{#unless section.allStored}}<li class="empty">{{localize "VARBORG.Sheet.Equipment.None"}}</li>{{/unless}}
      {{/each}}
    </ul>
  </section>
  {{/each}}
  <p class="hint">{{localize "VARBORG.Sheet.Equipment.DropHint"}}</p>

  <section class="resources silver-footer">
    <label class="resource">
      <span>{{localize "VARBORG.Sheet.Silver"}}</span>
      <input type="number" name="system.silver" value="{{system.silver}}" min="0" step="1">
    </label>
  </section>

  <section class="carrying carrying-{{carrying.state}}">
    <h2>{{localize "VARBORG.Carrying.Title"}}</h2>
    <p class="carrying-line">
      <span>{{localize "VARBORG.Carrying.CumbersomeCount" cumbersome=carrying.cumbersome limit=carrying.limit}}</span>
      <span class="carrying-state">{{localize carrying.stateLabel}}</span>
      <span>{{localize "VARBORG.Carrying.Movement"}}: {{localize "VARBORG.Carrying.Feet" value=carrying.movement}}</span>
    </p>
    <p class="hint">{{localize (concat "VARBORG.Carrying.Hint." carrying.state)}}</p>
    {{#if carrying.effects}}<p class="hint">{{carrying.effects}}</p>{{/if}}
  </section>
</section>

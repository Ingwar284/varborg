<section class="var-borg-table-panel var-borg-weather-panel">
  {{#if weather.on}}
  <div class="weather-row kind-{{weather.kind}}">
    {{{weather.flower}}}
    <div class="weather-text">
      <span class="weather-label">{{localize "VARBORG.Weather.Label"}}</span>
      <span class="weather-name">{{weather.name}}</span>
      {{#if weather.hazard}}
        <span class="weather-hazard" data-tooltip="{{weather.hazardEffect}}">
          <i class="fa-solid fa-triangle-exclamation"></i> {{weather.hazard}}</span>
      {{/if}}
      {{#if isGM}}
        <button type="button" class="set-weather" data-action="setWeather"
          data-tooltip="{{localize 'VARBORG.Weather.SetTooltip'}}"><i class="fa-solid fa-cloud-sun-rain"></i> {{localize "VARBORG.Weather.Set"}}</button>
      {{/if}}
    </div>
  </div>
  {{else}}
  <p class="hint">{{localize "VARBORG.Weather.Off"}}</p>
  {{/if}}
</section>

<section class="var-borg-table-panel">
  <div class="day-row">
    <span class="day-name"><i class="fa-solid fa-sun"></i> {{localize "VARBORG.Day.Label" day=day}}</span>
    {{#if isGM}}
      <button type="button" class="new-day" data-action="newDay"
        data-tooltip="{{localize 'VARBORG.Day.NewDayTooltip'}}">{{localize "VARBORG.Day.NewDay"}}</button>
      <button type="button" class="new-day rest" data-action="rest"
        data-tooltip="{{localize 'VARBORG.Rest.Tooltip'}}"><i class="fa-solid fa-bed"></i> {{localize "VARBORG.Rest.Button"}}</button>
    {{/if}}
  </div>
  <div class="light-row {{#if light.burning}}burning{{/if}}">
    <div class="light-head">
      <span class="light-name"><i class="fa-solid fa-fire-flame-curved"></i> {{localize "VARBORG.Light.Label"}}</span>
      {{#if light.burning}}
        <span class="light-clock" data-light-clock>{{light.clock}}</span>
      {{else}}
        <span class="hint">{{localize "VARBORG.Light.NoneBurning"}}</span>
      {{/if}}
    </div>
    {{#if light.waiting}}<p class="hint">{{localize "VARBORG.Light.PausedHint"}}</p>{{/if}}
    {{#if isGM}}
      <div class="light-controls">
        {{#if light.burning}}
          <button type="button" data-action="lightChange" data-minutes="-10"
            data-tooltip="{{localize 'VARBORG.Light.LessTooltip'}}">−10</button>
          <button type="button" data-action="lightChange" data-minutes="10"
            data-tooltip="{{localize 'VARBORG.Light.MoreTooltip'}}">+10</button>
          <button type="button" data-action="lightOut"
            data-tooltip="{{localize 'VARBORG.Light.OutTooltip'}}"><i class="fa-solid fa-moon"></i> {{localize "VARBORG.Light.Out"}}</button>
        {{else}}
          <input type="number" name="lightMinutes" value="{{light.defaultMinutes}}" min="1" step="1"
            aria-label="{{localize 'VARBORG.Light.MinutesLabel'}}" data-tooltip="{{localize 'VARBORG.Light.MinutesLabel'}}">
          <button type="button" data-action="lightStart"
            data-tooltip="{{localize 'VARBORG.Light.StartTooltip'}}"><i class="fa-solid fa-fire-flame-curved"></i> {{localize "VARBORG.Light.Start"}}</button>
        {{/if}}
      </div>
    {{/if}}
  </div>

  {{#if inCombat}}
    <p class="round">{{localize "VARBORG.Pools.Round" round=round fill=fill}}</p>
  {{else}}
    <p class="hint">{{localize "VARBORG.Pools.OutsideCombat"}}</p>
  {{/if}}

  {{#each pools}}
    <div class="pool {{id}}">
      <div class="pool-head">
        <span class="pool-name">{{symbol}} {{label}}</span>
        {{#if canAdjust}}
          <button type="button" class="adjust" data-action="adjust" data-pool="{{id}}" data-delta="-1"
            data-tooltip="{{localize 'VARBORG.Pools.Remove'}}" aria-label="{{localize 'VARBORG.Pools.Remove'}}">−</button>
        {{/if}}
        <span class="pool-count">{{left}}</span>
        {{#if canAdjust}}
          <button type="button" class="adjust" data-action="adjust" data-pool="{{id}}" data-delta="1"
            data-tooltip="{{localize 'VARBORG.Pools.Add'}}" aria-label="{{localize 'VARBORG.Pools.Add'}}">+</button>
        {{/if}}
      </div>
      {{#if canSpend}}
        <div class="pool-spend">
          <span class="spend-label">{{localize "VARBORG.Pools.Spend"}}</span>
          {{#each costs}}
            <button type="button" data-action="spend" data-pool="{{../id}}" data-cost="{{cost}}"
              {{#if disabled}}disabled{{/if}}>{{../symbol}}{{cost}}</button>
          {{/each}}
        </div>
      {{/if}}
    </div>
  {{/each}}

  {{#if isGM}}
    <button type="button" class="reset-ember" data-action="resetEmber"
      data-tooltip="{{localize 'VARBORG.Power.ResetTooltip'}}">
      <i class="fa-solid fa-rotate-left"></i> {{localize "VARBORG.Power.Reset"}}
    </button>
  {{/if}}
</section>

<section class="var-borg-table-panel var-borg-misery-panel">
  <header class="misery-head{{#if misery.end}} end{{/if}}">
    <span class="misery-numeral{{#unless misery.level}} none{{/unless}}">
      {{#if misery.level}}{{misery.numeral}}{{else}}<i class="fa-solid fa-skull" aria-hidden="true"></i>{{/if}}
    </span>
    <div class="misery-text">
      <span class="misery-label">{{localize "VARBORG.Misery.Label"}}</span>
      <span class="misery-name">{{misery.name}}</span>
      {{#if misery.end}}
        <span class="misery-sunless">{{localize "VARBORG.Misery.EndTitle"}}</span>
      {{else if misery.sunless}}
        <span class="misery-sunless"><i class="fa-solid fa-moon" aria-hidden="true"></i> {{localize "VARBORG.Misery.NoSunToday"}}</span>
      {{else if misery.sunDie}}
        <span class="misery-sun"><i class="fa-solid fa-sun" aria-hidden="true"></i> {{localize "VARBORG.Misery.Panel.SunDie" die=misery.sunDie}}</span>
      {{/if}}
    </div>
  </header>

  {{#if misery.omensMode}}
    {{#each misery.miseries}}
      <details class="misery-block{{#if newest}} newest{{/if}}{{#if done}} done{{/if}}" {{#if newest}}open{{/if}}>
        <summary>
          <span class="misery-badge">{{numeral}}</span>
          <span class="misery-block-name">{{name}}</span>
          <span class="misery-block-count">{{count}}</span>
          <i class="fa-solid fa-chevron-down misery-chevron" aria-hidden="true"></i>
        </summary>
        <ul class="omen-list">
          {{#each omens}}
            <li class="omen{{#if done}} done{{/if}}">
              <div class="omen-head">
                <span class="omen-name"><span class="omen-die">{{result}}</span> {{name}}</span>
                <span class="omen-pips" role="img" aria-label="{{stageLabel}}" data-tooltip="{{stageLabel}}">
                  {{#each pips}}<span class="omen-pip {{state}}"></span>{{/each}}
                </span>
              </div>
              {{#each stages}}
                {{#if current}}<p class="omen-now">{{text}}</p>{{/if}}
              {{/each}}
              {{#if hasEarlier}}
                <details class="omen-before">
                  <summary>{{localize "VARBORG.Misery.Panel.Earlier"}}</summary>
                  <ol class="omen-stages">
                    {{#each stages}}
                      {{#unless current}}<li value="{{n}}">{{text}}</li>{{/unless}}
                    {{/each}}
                  </ol>
                </details>
              {{/if}}
            </li>
          {{/each}}
        </ul>
      </details>
    {{/each}}
    {{#if misery.next}}<p class="misery-next"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i> {{misery.next}}</p>{{/if}}
  {{else}}
    {{#if misery.omen}}<p class="misery-current-omen">{{misery.omen}}</p>{{/if}}
  {{/if}}

  {{#if isGM}}
    <footer class="misery-foot">
      <span class="misery-light">{{#if misery.omensMode}}{{misery.mode}}{{else}}{{localize "VARBORG.Misery.LightIs" light=misery.light}}{{/if}}</span>
      <button type="button" class="set-misery" data-action="setMisery"
        data-tooltip="{{#if misery.omensMode}}{{localize 'VARBORG.Misery.Omens.SetTooltip'}}{{else}}{{localize 'VARBORG.Misery.SetTooltip'}}{{/if}}"><i class="fa-solid fa-skull"></i> {{localize "VARBORG.Misery.Set"}}</button>
    </footer>
  {{/if}}
</section>
